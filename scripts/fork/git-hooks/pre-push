#!/usr/bin/env bash
# Pre-push gate for the public fork. Install once per checkout:
#   git config --worktree core.hooksPath scripts/fork/git-hooks
# (or plain `git config core.hooksPath ...` when worktreeConfig is off).
#
# For every ref being pushed, every commit the fork added on top of upstream
# must be authored and committed as $FORK_EMAIL, and must pass check-public.sh.
# What reaches a public repo cannot be taken back, so this runs before the push.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
. "$root/scripts/fork/lib.sh"
zero=0000000000000000000000000000000000000000
status=0

while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue # deleting a remote ref
  mapfile -t args < <(fork_rev_args "$lsha")
  bad=$(git log --format='%h author=%ae committer=%ce' "${args[@]}" |
    awk -v e="$FORK_EMAIL" '$2 != "author=" e || $3 != "committer=" e')
  if [ -n "$bad" ]; then
    echo "pre-push: commits must use author and committer <$FORK_EMAIL>:" >&2
    printf '  %s\n' "$bad" >&2
    echo "  fix: git config --worktree user.email $FORK_EMAIL, then rewrite them (git rebase -r --exec 'git commit --amend --no-edit --reset-author' <base>)" >&2
    status=1
  fi
  "$root/scripts/fork/check-public.sh" "$lsha" >/dev/null || status=1
done

exit $status
